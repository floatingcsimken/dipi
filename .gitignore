node_modules/
**/node_modules/

# npm logfájlok
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Build & Kódkimenetek
# ==========================================
# TypeScript fordítási kimenetek és Vite build mappa
dist/
**/dist/
build/
**/build/

# Vite és egyéb keretrendszerek ideiglenes cache-jei
.vite/
**/.vite/
.eslintcache

# ==========================================
# Érzékeny Adatok & Környezeti Változók
# ==========================================
